      ],
      "effects": {
        "nudge": {
          "self": 2
        }
      }
    },
    {
      "note": "Looked around carefully.",
      "min_examined": 4,
      "effects": {
        "nudge": {
          "patience": 1
        }
      }
    },
    {
      "note": "Went straight through.",
      "max_examined": 1,
      "effects": {
        "nudge": {
          "speed": 1
        }
      }
    }
  ],
  "fights": {
    "brann": {
      "opponents": [
        "brann"
      ],
      "wounds": 3,
      "yield_at": 1,
      "yield_text": "Brann drops to one knee and raises a hand. \"Enough! Enough. He's yours.\"",
      "talk": [
        {
          "text": "Marta's choosing who climbs. Think she'll open the stair for a thug?",
          "requires": "marta_motive",
          "result": "yield",
          "reply": "\"...Not worth it.\""
        },
        {
          "text": "This isn't worth either of us bleeding.",
          "reply": "\"Then stop swinging.\""
        }
      ],
      "outcomes": {
        "spared": {
          "text": "Brann limps off into the dark. Behind you, Tobin lets out a long breath.",
          "effects": {
            "nudge": {
              "others": 1
            },
            "set_flags": [
              "brann_gone",
              "brann_spared"
            ]
          }
        },
        "talked_down": {
          "text": "Brann backs away with his hands open, and is gone.",
          "effects": {
            "nudge": {
              "persuasion": 1,
              "others": 1
            },
            "set_flags": [
              "brann_gone",
              "talked_down_brann"
            ]
          }
        },
        "killed": {
          "text": "Brann doesn't get up. Tobin stares at you and says nothing.",
          "effects": {
            "nudge": {
              "force": 2
            },
            "set_flags": [
              "brann_dead"
            ]
          },
          "body_name": "Brann",
          "body_lines": [
            "Brann. He doesn't move.",
            "Tobin won't look at you."
          ]
        },
        "lost": {
          "text": "Brann is gone, and so is Tobin's bird.",
          "effects": {
            "set_flags": [
              "lost_to_brann",
              "brann_gone",
              "bird_stolen"
            ]
          }
        }
      }
    }
  }
