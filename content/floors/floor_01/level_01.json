  "objects": [
    {
      "char": "P",
      "id": "signpost",
      "name": "Signpost",
      "kind": "examine",
      "model": "fantasy-town/pillar-wood",
      "scale": 1.3,
      "lines": [
        "A post with a board nailed to it: THE TOWER. An arrow points up the road.",
        "Under it, someone has scratched: TURN BACK. Under that, in a different hand: DON'T."
      ],
      "effects": {
        "learn": [
          "signpost"
        ]
      }
    },
    {
      "char": "C",
      "id": "supply_cart",
      "name": "Wrecked cart",
      "kind": "examine",
      "model": "fantasy-town/cart",
      "rot": 70,
      "lines": [
        "A supply cart, tipped into the ditch. Its sacks are split and the birds have had the grain.",
        "Painted on the side: a red gate. The Gatekeeper's mark."
      ],
      "effects": {
        "learn": [
          "gate_cart"
        ]
      }
    },
    {
      "char": "w",
      "id": "loose_wheel",
      "name": "Loose wheel",
      "kind": "examine",
      "model": "fantasy-town/wheel",
      "rot": 20,
      "blocking": false,
      "lines": [
        "One of the cart's wheels, lying in the grass. Its spokes are snapped, all on one side, as if something very heavy stepped on it."
      ],
      "effects": {
        "learn": [
          "heavy_step"
        ]
      }
    },
    {
      "char": "h",
      "id": "torn_ledger",
      "name": "Torn ledger page",
      "kind": "hidden",
      "shape": "plank",
      "size": [
        0.4,
        0.03,
        0.3
      ],
      "color": "#e8dcc0",
      "reveal_text": "Something pale in the grass.",
      "lines": [
        "A page torn from a ledger, half pulped by rain. 'Bread for the waiting hall: forty loaves.'",
        "The last line is in a different hand: 'No more deliveries. By order of M.'"
      ],
      "effects": {
        "learn": [
          "deliveries_stopped"
        ],
        "set_flags": [
          "found_ledger"
        ]
      }
    },
    {
      "char": "W",
      "id": "wil",
      "name": "Wil",
      "kind": "npc",
      "facing_deg": -45,
      "look": {
        "body": "worker",
        "head": "male-g",
        "colors": {
          "skin": "tan",
          "hair": "silver",
          "shirt": "steel",
          "pants": "brown",
          "shoes": "charcoal",
          "accent": "sand"
        }
      },
      "call_out": {
        "radius": 3,
        "flag": "heard_wil",
        "text": "\"Turning back's allowed, you know.\""
      },
      "dialogue": {
        "start": "hello",
        "start_if": [
          {
            "flag": "wil_done",
            "start": "again"
          }
        ],
        "nodes": {
          "hello": {
            "text": "An old man with a heavy pack, walking away from the tower. \"Going up? Huh.\"",
            "effects": {
              "set_flags": [
                "talked_wil"
              ]
            },
            "choices": [
              {
                "text": "Why are you leaving?",
                "next": "why",
                "hide_if": "asked_wil_why"
              },
              {
                "text": "What's up there?",
                "next": "what",
                "hide_if": "asked_wil_what"
              },
              {
                "text": "Do you need anything?",
                "next": "need",
                "hide_if": "wil_done"
              },
              {
                "text": "Goodbye.",
                "next": ""
              }
            ]
          },
          "why": {
            "text": "\"Waited at that gate forty days. Then one evening I looked up at the thing and thought: I like who I am down here.\"",
            "effects": {
              "set_flags": [
                "asked_wil_why"
              ]
            },
            "next": "hello"
          },
          "what": {
            "text": "\"Floors. Ten rooms to a floor, they say, and someone at the top of each who won't let you by easy. First one's the Gatekeeper. Marta.\"",
            "effects": {
              "learn": [
                "marta_name",
                "tower_floors"
              ],
              "set_flags": [
                "asked_wil_what"
              ]
            },
            "next": "hello"
          },
          "need": {
            "text": "He thinks about it. \"My daughter's at the climbers' camp, up the road. Tell her I went home. She'll know what it means.\"",
            "choices": [
              {
                "text": "I'll tell her.",
                "next": "promise",
                "effects": {
                  "nudge": {
                    "others": 1
                  },
                  "set_flags": [
                    "carrying_wil_message",
                    "wil_done"
                  ]
                }
              },
              {
                "text": "I can't promise that.",
                "next": "no_promise",
                "effects": {
                  "nudge": {
                    "honesty": 0.5,
                    "self": 0.5
                  },
                  "set_flags": [
                    "wil_done"
                  ]
                }
              }
            ]
          },
          "promise": {
            "text": "\"Her name's Ada. Thank you.\" He shifts his pack and keeps walking.",
            "effects": {
              "learn": [
                "ada"
              ]
            }
          },
          "no_promise": {
            "text": "\"Honest, at least. That's rarer up there than you'd think.\""
          },
          "again": {
            "text": "\"Road's that way. Up.\" He nods toward the tower."
          }
        }
      }
    },
    {
      "char": "E",
      "id": "road_on",
      "name": "Road to the river",
      "kind": "exit",
      "model": "fantasy-town/lantern",
      "dialogue": {
        "start": "ask",
        "nodes": {
          "ask": {
            "text": "The road runs on toward the river and the tower beyond it. Go on?",
