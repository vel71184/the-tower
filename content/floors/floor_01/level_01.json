  "title": "Floor 1 · The Waiting Hall",
  "draft_note": "Floor 1, level 1: the lobby just inside the gate. Level 10 is Marta, the Gatekeeper, at the stair. Marta is a draft boss for testing.",
  "palette": {
    "floor_a": "#5b5148",
    "floor_b": "#544a42",
    "wall": "#8a7f72"
