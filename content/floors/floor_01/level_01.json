  ],
  "objects": [
    {
      "char": "G",
      "id": "entry_gate",
      "name": "The gate",
      "kind": "examine",
      "shape": "arch",
      "color": "#7d6a52",
      "lines": [
        "The gate you came in through. It swung shut behind you on its own.",
        "There's no handle on this side."
      ],
      "effects": {
        "learn": [
          "no_way_back"
        ]
      }
    },
    {
      "char": "N",
      "id": "notice_board",
      "name": "Notice board",
      "kind": "examine",
      "shape": "box",
      "size": [
        0.9,
        1.4,
        0.2
      ],
      "color": "#a0784c",
      "lines": [
        "BY ORDER OF THE GATEKEEPER: the stair is closed. Climbers who wait will be seen in turn.",
        "Below it, rows of tally marks. Someone has been counting days. The newest marks are in a child's hand."
      ],
      "effects": {
        "learn": [
          "stair_closed"
        ]
      }
    },
    {
      "char": "C",
      "id": "campfire",
      "name": "Cold campfire",
      "kind": "examine",
      "shape": "cylinder",
      "size": [
        0.7,
        0.2,
        0.7
      ],
      "color": "#3b3330",
      "lines": [
        "Ash, long cold. Someone cooked here for weeks, then stopped.",
        "A pot lies on its side. Whoever left it didn't plan on coming back down."
      ]
    },
    {
      "char": "B",
      "id": "bedrolls",
      "name": "Bedrolls",
      "kind": "examine",
      "shape": "box",
      "size": [
        0.8,
        0.15,
        0.5
      ],
      "color": "#6e5a44",
      "dialogue": {
        "start": "look",
        "nodes": {
          "look": {
            "text": "Bedrolls along the wall. Most have gathered dust. One is still warm.",
            "choices": [
              {
                "text": "Rest a while.",
                "action": "rest",
                "requires_hurt": true
              },
              {
                "text": "Leave them.",
                "next": ""
              }
            ]
          }
        }
      },
      "rest_spot": true,
      "rest_place": "the bedrolls"
    },
    {
      "char": "T",
      "id": "tobin",
      "name": "Tobin",
      "kind": "npc",
      "call_out": {
        "radius": 3,
        "flag": "heard_tobin",
        "text": "Hey! You're climbing too?"
      },
      "dialogue": {
        "start": "hello",
        "start_if": [
          {
            "flag": "brann_dead",
            "unless": "tobin_saw_kill",
            "start": "after_kill"
          },
          {
            "flag": "brann_gone",
            "unless": "thanked",
            "start": "thanks"
          },
          {
            "flag": "carrying_bird",
            "start": "again_bird"
          },
          {
            "flag": "tobin_done",
            "start": "again"
          }
        ],
        "nodes": {
          "hello": {
            "text": "Thirty-one days I've waited here. She says I'm not ready. Maybe nobody is.",
            "effects": {
              "set_flags": [
                "talked_tobin"
              ]
            },
            "choices": [
              {
                "text": "Who says you're not ready?",
                "next": "marta"
              },
              {
                "text": "Why are you climbing?",
                "next": "sister"
              },
              {
                "text": "Good luck.",
                "next": "brush_off",
                "effects": {
                  "nudge": {
                    "self": 0.5
                  }
                }
              }
            ]
          },
          "marta": {
            "text": "Marta. The Gatekeeper. They say she used to wave everyone through. Then she let one up who'd burned half the floor getting to the stair. Now nobody goes up.",
            "effects": {
              "learn": [
                "marta_name",
                "last_climber_burned"
              ]
            },
            "next": "more"
          },
          "more": {
            "text": "Anything else?",
            "choices": [
              {
                "text": "Why are you climbing?",
                "next": "sister",
                "hide_if": "tobin_done"
              },
              {
                "text": "That's all.",
                "next": ""
              }
            ]
          },
          "sister": {
            "text": "My sister went up a year ago. Never sent word. I carved her this.",
            "next": "ask"
          },
          "ask": {
            "text": "He holds out a small wooden bird. \"If you get further than me... would you carry it up? Show it around?\"",
            "choices": [
              {
                "text": "I'll carry it.",
                "next": "took",
                "effects": {
                  "nudge": {
                    "others": 1
                  },
                  "set_flags": [
                    "carrying_bird",
                    "tobin_done"
                  ]
                }
              },
              {
                "text": "I travel light.",
                "next": "refused",
                "effects": {
                  "nudge": {
                    "self": 1
                  },
                  "set_flags": [
                    "refused_bird",
                    "tobin_done"
                  ]
                }
              }
            ]
          },
          "took": {
            "text": "He presses it into your hand and doesn't let go right away. \"Her name's Wren.\"",
            "effects": {
              "learn": [
                "wren"
              ]
            }
          },
          "refused": {
            "text": "\"Right. Course.\" He tucks the bird back inside his coat."
          },
          "brush_off": {
            "text": "\"Yeah. You too.\" He goes back to counting the marks on the board."
          },
          "again_bird": {
            "text": "\"Her name's Wren. Don't forget.\""
          },
          "again": {
            "text": "\"Still here.\""
          },
          "thanks": {
            "text": "\"He's gone? He's been on me for weeks. Thank you.\"",
            "effects": {
              "nudge": {
                "others": 0.5
              },
              "set_flags": [
                "thanked"
              ]
            },
            "next": "hello"
          },
          "after_kill": {
            "text": "Tobin won't look at you. \"He was just... hungry. Like the rest of us.\"",
            "effects": {
              "set_flags": [
                "tobin_saw_kill"
              ]
            },
            "next": ""
          }
        }
      },
      "look": {
        "body": "male-f",
        "head": "male-e",
        "colors": {
          "skin": "tan",
          "hair": "coral",
          "shirt": "sky",
          "pants": "brown",
          "shoes": "charcoal"
        }
      }
    },
    {
      "char": "K",
      "id": "brann",
      "name": "Brann",
      "kind": "npc",
      "facing_deg": 90,
      "look": {
        "body": "raider",
        "head": "male-g",
        "scale": 1.12,
        "colors": {
          "skin": "tan",
          "hair": "charcoal",
          "shirt": "brown",
          "pants": "ink",
          "shoes": "charcoal",
          "accent": "sand"
        }
      },
      "call_out": {
        "radius": 3,
        "flag": "heard_brann",
        "text": "\"Keep walking.\""
      },
      "dialogue": {
        "start": "hello",
        "nodes": {
          "hello": {
            "text": "\"Keep walking. This one owes me.\" He has a fist in Tobin's coat.",
            "choices": [
              {
                "text": "Owes you what?",
                "next": "toll",
                "hide_if": "heard_toll"
              },
              {
                "text": "Let him go.",
                "next": "make_me"
              },
              {
                "text": "Marta's choosing who climbs. Think she'll open the stair for a thug?",
                "requires_knowledge": "marta_motive",
                "next": "talked_down"
              },
              {
                "text": "(Hit him first.)",
                "action": "fight:brann:strike",
                "effects": {
                  "nudge": {
                    "force": 1
                  }
                }
              },
              {
                "text": "Not my business.",
                "next": "",
                "effects": {
                  "nudge": {
                    "self": 1
                  },
                  "set_flags": [
                    "ignored_brann"
                  ]
                }
              }
            ]
          },
          "toll": {
            "text": "\"Everyone who waits pays the one who's waited longest. That's me. Bread, coin, that stupid bird of his.\"",
            "effects": {
              "learn": [
                "brann_toll"
              ],
              "set_flags": [
                "heard_toll"
              ]
            },
            "next": "hello"
          },
          "make_me": {
            "text": "\"Make me.\" He lets go of Tobin and squares up to you.",
            "choices": [
              {
                "text": "Fight him.",
                "action": "fight:brann",
                "effects": {
                  "nudge": {
                    "others": 0.5
                  }
                }
              },
              {
                "text": "Back off.",
                "next": "",
                "effects": {
                  "nudge": {
                    "self": 1
                  },
                  "set_flags": [
                    "backed_off_brann"
                  ]
                }
              }
            ]
          },
          "talked_down": {
            "text": "He looks toward the stair, then back at you. \"...Not worth it.\" He lets go of Tobin and walks off into the dark.",
            "effects": {
              "nudge": {
                "persuasion": 1,
                "others": 1
              },
              "set_flags": [
                "brann_gone",
                "talked_down_brann"
              ]
            },
            "action": "leave"
          }
        }
      }
    },
    {
      "char": "h",
      "id": "loose_board",
      "name": "Loose floorboard",
      "kind": "hidden",
      "shape": "plank",
      "color": "#8b6b47",
      "lines": [
        "You pry the board up. Underneath, wrapped in oilcloth, is a folded letter.",
        "\"Brother. I let the last one through, like all the others. The fires were at the far end of the floor; by the time word reached the stair, they were already up it. Forty houses.",
        "Now the one above comes down to the landing every few days to tell me what they're doing up there. It's worse every time.",
        "I won't open the stair again until I've watched who's climbing, all the way across our floor. If they ask, tell them I'm cruel. It's easier. — M.\""
      ],
      "effects": {
        "learn": [
          "marta_motive"
        ],
        "set_flags": [
          "found_letter"
        ]
      },
      "reveal": "step",
      "after_use": {
        "open": true
      },
      "lines_after": [
        "The board's pried up. Nothing else under it."
      ]
    },
    {
      "char": "E",
      "id": "passage",
      "name": "Passage into the gatehouse",
      "kind": "exit",
      "shape": "arch",
      "color": "#c2b49c",
      "dialogue": {
        "start": "ask",
        "nodes": {
          "ask": {
            "text": "The passage leads deeper into the gatehouse. Somewhere beyond it is the stair, and the Gatekeeper. Go on?",
            "choices": [
              {
                "text": "Go on.",
                "action": "end_level"
              },
              {
                "text": "Not yet.",
                "next": ""
              }
            ]
          }
        }
      }
    }
  ],
  "end_rules": [
