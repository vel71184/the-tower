    {
      "char": "P",
      "id": "pell",
      "name": "Pell",
      "kind": "npc",
      "facing_deg": 45,
      "look": {
        "body": "male-c",
        "head": "male-a",
        "idle": "sit",
        "colors": {
          "skin": "tan",
          "hair": "sand",
          "shirt": "sky",
          "pants": "brown",
          "shoes": "charcoal",
          "accent": "sand"
        }
      },
      "dialogue": {
        "start": "hello",
        "nodes": {
          "hello": {
            "text": "A young man sits at the end of the bridge, one leg out at a bad angle. \"Mind the bridge. One of the planks gives.\"",
            "effects": {
              "set_flags": [
                "talked_pell"
              ]
            },
            "choices": [
              {
                "text": "What happened?",
                "next": "what",
                "hide_if": "asked_pell_what"
              },
              {
                "text": "Rotten? Someone cut that plank.",
                "next": "truth",
                "requires": "asked_pell_what",
                "requires_knowledge": "plank_cut",
                "hide_if": "pell_told_truth"
              },
              {
                "text": "Is this hers? It was in the reeds.",
                "next": "saw",
                "requires": "found_saw",
                "hide_if": "pell_told_truth"
              },
              {
                "text": "Can you walk?",
                "next": "walk",
                "hide_if": "pell_needs_splint"
              },
              {
                "text": "Here. Let's bind it to this.",
                "next": "splint",
                "requires": "has_branch",
                "hide_if": "pell_helped"
              },
              {
                "text": "What's it worth to you?",
                "next": "worth",
                "requires": "pell_needs_splint",
                "hide_if": "pell_bargained"
              },
              {
                "text": "I'll tell them at the camp.",
                "next": "promise",
                "requires": "pell_needs_splint",
                "hide_if": "pell_promised"
              },
              {
                "text": "Good luck.",
                "next": ""
              }
            ]
          },
          "what": {
            "text": "\"It just went. Rotten, I suppose.\" He doesn't look at the plank when he says it.",
            "effects": {
              "set_flags": [
                "asked_pell_what"
              ]
            },
            "next": "hello"
          },
          "truth": {
            "text": "He's quiet a moment. \"Sorrel. We walked from the coast together. Last night she said there'd be less of a crowd at the gate by morning. I didn't think she meant this.\"",
            "effects": {
              "learn": [
                "sorrel"
              ],
              "set_flags": [
                "pell_told_truth"
              ]
            },
            "next": "hello"
          },
          "walk": {
            "text": "\"Not on this. If I had something straight to bind it to, I could make the camp.\"",
            "effects": {
              "set_flags": [
                "pell_needs_splint"
              ]
            },
            "next": "hello"
          },
          "worth": {
            "text": "\"Everything I've got. Which is one coin.\" He holds it up.",
            "effects": {
              "set_flags": [
                "pell_bargained"
              ],
              "nudge": {
                "self": 1
              }
            },
            "next": "hello"
          },
          "promise": {
            "text": "\"My friend Bryn's there. She'll come. Tell her where I am.\"",
            "effects": {
              "set_flags": [
                "pell_promised"
              ],
              "nudge": {
                "others": 0.5,
                "speed": 0.5
              }
            },
            "next": "hello"
          },
          "splint": {
            "text": "You bind the leg to the branch with his own belt. He gets up on the second try, gray in the face.",
            "effects": {
              "set_flags": [
                "pell_helped",
                "pell_at_camp"
              ],
              "nudge": {
                "others": 1,
                "patience": 0.5
              }
            },
            "choices": [
              {
                "text": "Go on.",
                "next": "thanks"
              }
            ]
          },
          "thanks": {
            "text": "\"I'll make the camp by dark.\" He holds out a coin. \"It's all I have. Take it.\"",
            "choices": [
              {
                "text": "Take the coin.",
                "next": "bye",
                "effects": {
                  "set_flags": [
                    "has_coin",
                    "took_pell_coin"
                  ],
                  "nudge": {
                    "self": 0.5
                  }
                }
              },
              {
                "text": "Keep it.",
                "next": "bye",
                "effects": {
                  "nudge": {
                    "others": 0.5
                  }
                }
              }
            ]
          },
          "bye": {
            "text": "He limps off toward the camp, slow, but on his own.",
            "action": "leave"
          },
          "saw": {
            "text": "He looks at the S on the rag a long time. \"Sorrel. We walked from the coast together. Last night she said there'd be less of a crowd at the gate by morning. I didn't think she meant this.\"",
            "effects": {
              "learn": [
                "sorrel"
              ],
              "set_flags": [
                "pell_told_truth"
              ]
            },
            "next": "hello"
          }
        }
      },
      "unless": "pell_rescued"
    },
    {
      "char": "m",
      "id": "bank_rock",
      "name": "Flat rock",
      "kind": "examine",
      "model": "fantasy-town/rock-wide",
