      "rest_spot": true,
      "rest_place": "the flat rock on the bank",
      "dialogue": {
        "start": "rest",
        "nodes": {
          "rest": {
            "text": "A flat rock on the bank, out of the wind. You can hear the river from here.",
            "choices": [
              {
                "text": "Rest a while.",
                "action": "rest",
                "requires_hurt": true
              },
              {
                "text": "Move on.",
                "next": ""
              }
            ]
          }
        }
      },
      "recolor": {
        "#a0a8c9": "#a29d93"
      }
    }
  ],
