          "text": "Hesk lowers the sword. \"Knowing when to stop counts too.\"",
          "effects": {
            "set_flags": [
              "spar_done"
            ],
            "nudge": {
              "persuasion": 0.5
            },
            "heal": true
          }
        },
        "killed": {
          "text": "The practice sword falls out of his hand. Around the ring, the whole camp has gone quiet.",
          "effects": {
            "set_flags": [
              "hesk_dead",
              "killed_at_camp"
            ],
            "nudge": {
              "force": 2,
              "self": 1
            }
          },
          "body_name": "Hesk",
          "body_lines": [
            "Hesk. He trained climbers for thirty years and never went in.",
            "Nobody in the camp will come near you."
          ]
        },
        "lost": {
          "leaves": false,
          "stay_put": true,
          "text": "You hit the dirt. Hesk hauls you up and checks you over. \"That's how it goes in there, except nobody helps you up. Again, when you're ready.\"",
          "effects": {
            "set_flags": [
              "spar_done",
              "spar_lost"
            ],
            "heal": true
          }
        }
      },
      "consensual": true
    }
