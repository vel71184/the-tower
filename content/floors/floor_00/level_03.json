    {
      "char": "N",
      "id": "notes_post",
      "name": "Post of fallen notes",
      "kind": "examine",
      "model": "fantasy-town/pillar-wood",
      "lines": [
        "Scraps people found at the foot of the tower, pinned to a post. Most are blank, rained out.",
        "One reads: \"Ma, I'm fine. Don't come.\" No name.",
        "Another, in a careful hand: \"Smoke all week up here. Forty houses. Whatever you hear, don't send the boy.\""
      ],
      "effects": {
        "learn": [
          "notes_come_down"
        ]
      }
    },
    {
      "char": "O",
      "id": "oda",
      "name": "Oda",
      "kind": "npc",
      "facing_deg": -135,
      "look": {
        "body": "female-d",
        "head": "female-a",
        "colors": {
          "skin": "tan",
          "hair": "silver",
          "shirt": "slate",
          "pants": "ink",
          "shoes": "brown",
          "accent": "red"
        },
        "idle": "sit"
      },
      "dialogue": {
        "start": "hello",
        "start_if": [
          {
            "flag": "hesk_dead",
            "start": "afraid"
          }
        ],
        "nodes": {
          "hello": {
            "text": "An old woman sits facing the tower, turning a gray feather in her fingers. \"Three years. One bird. It said Jory's alive.\"",
            "choices": [
              {
                "text": "Who's Jory?",
                "next": "jory"
              },
              {
                "text": "Only one bird?",
                "next": "birds"
              },
              {
                "text": "Goodbye.",
                "next": ""
              }
            ]
          },
          "jory": {
            "text": "\"My son. He went in at sixteen. Nobody comes back out, you know that? Not ever. Birds do. Sometimes.\"",
            "effects": {
              "learn": [
                "no_way_down"
              ]
            },
            "next": "hello"
          },
          "birds": {
            "text": "\"Most get lost. They go up wrong, come down wrong. Folk find notes on the ground meant for somebody three floors over. Still. One is one more than none.\"",
            "effects": {
              "learn": [
                "birds_get_lost"
              ]
            },
            "next": "hello"
          },
          "afraid": {
            "text": "She closes her hand around the feather and won't look at you."
          }
        }
      }
    },
    {
      "char": "A",
      "id": "ada",
      "name": "Ada",
      "kind": "npc",
      "facing_deg": -100,
      "look": {
        "body": "female-b",
        "head": "female-f",
        "colors": {
          "skin": "tan",
          "hair": "brown",
          "shirt": "steel",
          "pants": "charcoal",
          "shoes": "brown",
          "accent": "sand"
        }
      },
      "dialogue": {
        "start": "hello",
        "start_if": [
          {
            "flag": "hesk_dead",
            "start": "afraid"
          },
          {
            "flag": "ada_hates",
            "start": "afraid"
          },
          {
            "flag": "ada_done",
            "start": "again"
          }
        ],
        "nodes": {
          "hello": {
            "text": "A young woman by the fire, sharpening a knife she doesn't quite know how to hold. \"You came up the road. Did you pass an old man with a heavy pack?\"",
            "effects": {
              "set_flags": [
                "talked_ada"
              ],
              "learn": [
                "ada"
              ]
            },
            "choices": [
              {
                "text": "He's dead. I killed him.",
                "next": "dead",
                "requires": "killed:wil",
                "hide_if": "ada_told",
                "effects": {
                  "set_flags": [
                    "ada_told",
                    "told_ada_killed"
                  ],
                  "nudge": {
                    "honesty": 1
                  }
                }
              },
              {
                "text": "He said to tell you he went home. That you'd know what it means.",
                "next": "told",
                "requires": "carrying_wil_message",
                "hide_if": "ada_told",
                "effects": {
                  "set_flags": [
                    "ada_told",
                    "wil_message_delivered"
                  ],
                  "nudge": {
                    "honesty": 0.5,
                    "others": 0.5
                  }
                }
              },
              {
                "text": "He's waiting for you at home.",
                "next": "lied",
                "requires": "carrying_wil_message",
                "hide_if": "ada_told",
                "effects": {
                  "set_flags": [
                    "ada_told",
                    "ada_lied"
                  ],
                  "nudge": {
                    "deception": 1
                  }
                }
              },
              {
                "text": "I didn't see anyone.",
                "next": "withheld",
                "requires": "talked_wil",
                "hide_if": "ada_told",
                "effects": {
                  "set_flags": [
                    "ada_told",
                    "ada_withheld"
                  ],
                  "nudge": {
                    "deception": 1,
                    "self": 0.5
                  }
                }
              },
              {
                "text": "I passed him. He was walking away from the tower.",
                "next": "told",
                "requires": "talked_wil",
                "hide_if": "ada_told",
                "effects": {
                  "set_flags": [
                    "ada_told"
                  ],
                  "nudge": {
                    "honesty": 0.5
                  }
                }
              },
              {
                "text": "No. Sorry.",
                "next": "",
                "hide_if": "talked_wil"
              }
            ]
          },
          "told": {
            "text": "She's quiet a long time. \"It means he's stopped waiting for her. My mother. She went in two winters ago.\" She sets the knife down. \"He's allowed to stop. I'm not.\"",
            "choices": [
              {
                "text": "Go on.",
                "next": "ribbon"
              }
            ]
          },
          "lied": {
            "text": "She looks at you for a long moment. \"He'd never say that. But thank you.\"",
            "choices": [
              {
                "text": "Go on.",
                "next": "ribbon"
              }
            ]
          },
          "withheld": {
            "text": "\"Then he's still coming.\" She goes back to the knife, watching the road.",
            "effects": {
              "set_flags": [
                "ada_done"
              ]
            }
          },
          "ribbon": {
            "text": "She pulls a faded blue ribbon from her sleeve. \"If you go in before me... she'd know this. If you see a woman with gray in her hair who calls herself Ines, show her. Nothing gets carried up except by people.\"",
            "choices": [
              {
                "text": "I'll carry it.",
                "next": "carry",
                "effects": {
                  "set_flags": [
                    "carrying_ada_ribbon",
                    "ada_done"
                  ],
                  "learn": [
                    "ines"
                  ],
                  "nudge": {
                    "others": 1
                  }
                }
              },
              {
                "text": "I can't promise that.",
                "next": "no_carry",
                "effects": {
                  "set_flags": [
                    "ada_done"
                  ],
                  "nudge": {
                    "honesty": 0.5,
                    "self": 0.5
                  }
                }
              }
            ]
          },
          "carry": {
            "text": "She ties it around your wrist herself. Tight."
          },
          "no_carry": {
            "text": "\"No. Nobody can.\""
          },
          "again": {
            "text": "Ada's watching the road again. Or the tower. It's hard to tell which."
          },
          "afraid": {
            "text": "Ada stands up fast, the knife held the wrong way round, and backs off until there's a fire between you."
          },
          "dead": {
            "text": "She doesn't move. The knife slips and cuts her thumb and she doesn't notice. \"Get away from me.\"",
            "effects": {
              "set_flags": [
                "ada_done",
                "ada_hates"
              ]
            }
          }
        }
      }
    },
    {
