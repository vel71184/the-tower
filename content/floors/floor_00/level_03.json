        "nodes": {
          "hello": {
            "text": "A broad man leans on a practice sword in the middle of a fenced ring. \"Going in? Then you'll want to know how not to die on the first floor. Costs you nothing but bruises.\"",
            "choices": [
              {
                "text": "Teach me.",
                "next": "lesson"
              },
              {
                "text": "Who are you?",
                "next": "who"
              },
              {
                "text": "Not now.",
                "next": ""
              }
            ]
          },
          "who": {
            "text": "\"Thirty years a soldier, out here. Never went in. Somebody has to teach you lot before you do.\"",
            "next": "hello"
          },
          "lesson": {
            "text": "\"Nobody gets hit by accident in there. You pick who you're fighting first, and then you mean it. Watch me: when I wind up, get out of the way or get your guard up. And if I yield, you choose what happens next. Ready?\"",
            "choices": [
              {
                "text": "Ready.",
                "action": "fight:spar"
              },
              {
                "text": "Later.",
                "next": ""
              }
            ]
          },
          "again": {
            "text": "\"Ring's open, if you want another go.\"",
            "choices": [
              {
                "text": "Again.",
                "action": "fight:spar"
              },
              {
                "text": "Not now.",
                "next": ""
              }
            ]
          }
        }
      },
      "ground": "dirt"
    }
  ],
  "fights": {
    "spar": {
      "opponents": [
        "hesk"
      ],
      "wounds": 3,
      "yield_at": 1,
      "yield_text": "Hesk drops the practice sword and raises a hand. \"Yield! That's the last lesson: when someone yields, you choose.\"",
      "talk": [
        {
          "text": "Enough for today.",
          "result": "yield",
          "reply": "\"Fair.\""
        }
      ],
      "outcomes": {
        "spared": {
          "stays": true,
          "text": "Hesk laughs and rubs his arm. \"Good. Plenty take a third swing. You didn't.\" He checks you over and wraps your knuckles.",
          "effects": {
            "set_flags": [
              "spar_done",
              "spar_spared"
            ],
            "nudge": {
              "others": 0.5
            },
            "heal": true
          }
        },
        "talked_down": {
