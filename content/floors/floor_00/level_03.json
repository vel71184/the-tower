        ],
        "nodes": {
          "hello": {
            "text": "A woman paces at the edge of camp, watching the road. \"Did you come over the river? There's a lad, Pell. He was meant to be right behind me.\"",
            "choices": [
              {
                "text": "He's hurt, by the bridge. His leg.",
                "next": "go",
                "requires": "talked_pell",
                "effects": {
                  "set_flags": [
                    "bryn_went",
                    "pell_rescued",
                    "pell_at_camp"
                  ],
                  "nudge": {
                    "others": 0.5,
                    "honesty": 0.5
                  }
                }
              },
              {
                "text": "I didn't see him.",
                "next": "lie",
                "requires": "talked_pell",
                "hide_if": "lied_to_bryn",
                "effects": {
                  "set_flags": [
                    "lied_to_bryn"
                  ],
                  "nudge": {
                    "deception": 1,
                    "self": 0.5
                  }
                }
              },
              {
                "text": "No, sorry.",
                "next": "",
                "hide_if": "talked_pell"
              },
              {
                "text": "Goodbye.",
                "next": "",
                "requires": "talked_pell"
              }
            ]
          },
          "go": {
            "text": "\"Hurt? And you just...\" She doesn't finish. She grabs a bag and runs for the river.",
            "effects": {},
            "action": "step_away"
          },
          "lie": {
            "text": "\"Then where is he?\" She goes back to watching the road."
          },
          "afraid": {
            "text": "Bryn steps back, hands up, and doesn't take her eyes off you."
          },
          "helped": {
            "text": "Bryn sits by Pell, redoing his splint properly. \"You're the one who bound his leg? Thank you. He'd still be sitting there.\""
          },
          "rescued": {
            "text": "Bryn sits by Pell, redoing his splint. \"Found him right where you said. Thank you.\""
          }
