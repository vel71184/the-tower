      "dialogue": {
        "start": "shut",
        "start_if": [
          {
            "flag": "gate_open",
            "start": "open"
          }
        ],
        "nodes": {
          "shut": {
            "text": "The gate into the tower. Iron-banded wood, taller than three of you. There's no handle on this side. It opens from within."
          },
          "open": {
            "text": "The gate stands open a crack. Beyond it, lamplight and a long hall. Once you're through, there's no coming back out. Go in?",
            "choices": [
              {
                "text": "Go in.",
                "action": "end_level"
              },
              {
                "text": "Not yet.",
                "next": ""
              }
            ]
          }
        }
      }
    },
    {
      "char": "h",
      "id": "bread_hatch",
      "name": "Bread hatch",
      "kind": "hidden",
      "model": "castle-kit/door",
      "scale": 0.45,
      "dialogue": {
        "start": "hatch",
        "nodes": {
          "hatch": {
            "text": "A low wooden hatch at the foot of the wall, the kind bread gets pushed through. Since the deliveries stopped, nobody's barred it. It's just wide enough to crawl through. Once you're through, there's no coming back out.",
            "choices": [
              {
                "text": "Crawl through.",
                "action": "end_level",
                "effects": {
                  "set_flags": [
                    "sneaked_in"
                  ],
                  "nudge": {
                    "speed": 0.5,
                    "deception": 0.5
                  }
                }
              },
              {
                "text": "Leave it.",
                "next": ""
              }
            ]
          }
        }
      }
    },
    {
      "char": "M",
      "id": "dunmore",
      "name": "Dunmore",
      "kind": "npc",
      "facing_deg": -135,
      "look": {
        "body": "worker",
        "head": "male-b",
        "colors": {
          "skin": "coral",
          "hair": "brown",
          "shirt": "red",
          "pants": "charcoal",
          "shoes": "brown",
          "accent": "red"
        }
      },
      "dialogue": {
        "start": "hello",
        "start_if": [
          {
            "flag": "gate_open",
            "start": "done"
          },
          {
            "flag": "attacked:dunmore",
            "start": "wary"
          }
        ],
        "nodes": {
          "hello": {
            "text": "A heavy man on a stool by the gate, a ledger on his knee and red on his sleeve. \"Name? Doesn't matter. Gate opens for those who've paid the toll. One coin.\"",
            "effects": {
              "set_flags": [
                "talked_dunmore"
              ]
            },
            "choices": [
              {
                "text": "Who says there's a toll?",
                "next": "who",
                "hide_if": "asked_dunmore_who"
              },
              {
                "text": "Here. One coin.",
                "next": "paid",
                "requires": "has_coin",
                "effects": {
                  "set_flags": [
                    "gate_open",
                    "paid_toll"
                  ],
                  "nudge": {
                    "speed": 0.5
                  }
                }
              },
              {
                "text": "Marta stopped the bread. Does she know you're charging tolls at her gate?",
                "next": "talked",
                "requires_knowledge": "deliveries_stopped",
                "requires": "asked_dunmore_who",
                "effects": {
                  "set_flags": [
                    "gate_open",
                    "talked_dunmore_down"
                  ],
                  "nudge": {
                    "persuasion": 1
                  }
                }
              },
              {
                "text": "I'll wait.",
                "next": "waited",
                "effects": {
                  "set_flags": [
                    "gate_open",
                    "waited_at_gate"
                  ],
                  "nudge": {
                    "patience": 1
                  }
                }
              },
              {
                "text": "Never mind.",
                "next": ""
              }
            ]
          },
          "who": {
            "text": "\"I say. The Gatekeeper's busy inside. Somebody's got to keep order out here.\" He taps the red on his sleeve, as if that settles it.",
            "effects": {
              "set_flags": [
                "asked_dunmore_who"
              ],
              "learn": [
                "toll_racket"
              ]
            },
            "next": "hello"
          },
          "paid": {
            "text": "He bites the coin, pockets it, and raps on the gate three times. Somewhere inside, a bar lifts."
          },
          "talked": {
            "text": "The color goes out of his face. \"...Go on. Go on, then. You never saw me.\" He raps on the gate three times, quick."
          },
          "waited": {
            "text": "You sit with your back to the wall while the shadows stretch toward the river. At dusk Dunmore grumbles, gets up, and raps on the gate. \"Fine. Patience is a toll too, I suppose.\""
          },
          "done": {
            "text": "\"Go on, then. Before I change my mind.\""
          },
          "wary": {
            "text": "Dunmore keeps the stool between you and him. \"Gate's shut to you. Find another way, or don't.\""
          }
        }
      }
    },
    {
      "char": "m",
      "id": "wall_bench",
      "name": "Bench by the wall",
      "kind": "examine",
      "model": "fantasy-town/stall-bench",
      "rot": 0,
      "rest_spot": true,
      "rest_place": "the bench by the wall",
      "dialogue": {
        "start": "rest",
        "nodes": {
          "rest": {
            "text": "A bench against the tower wall, worn smooth by everyone who's sat here waiting to be let in.",
            "choices": [
              {
                "text": "Rest a while.",
                "action": "rest",
                "requires_hurt": true
              },
              {
                "text": "Move on.",
                "next": ""
              }
            ]
          }
        }
      }
    }
  ],
  "fights": {
    "dunmore": {
      "opponents": [
        "dunmore"
      ],
      "wounds": 3,
      "yield_at": 1,
      "yield_text": "Dunmore drops to his knees, hands up. \"All right! All right! I'll open it!\"",
      "talk": [
        {
          "text": "Open the gate and we're done.",
          "result": "yield",
          "reply": "\"Done! Done.\""
        }
      ],
      "outcomes": {
        "spared": {
          "text": "Dunmore raps on the gate with a shaking fist, and runs for the camp without his ledger.",
          "effects": {
            "set_flags": [
              "gate_open",
              "dunmore_spared"
            ],
            "nudge": {
              "force": 1
            }
          }
        },
        "talked_down": {
          "text": "Dunmore raps on the gate, three times, and sits back down very carefully.",
          "effects": {
            "set_flags": [
              "gate_open"
            ],
            "nudge": {
              "force": 0.5,
              "persuasion": 0.5
            }
          },
          "stays": true
        },
        "killed": {
          "text": "Dunmore doesn't get up. You hammer on the gate with his ledger until a bar lifts on the other side.",
          "effects": {
            "set_flags": [
              "gate_open",
              "dunmore_dead"
            ],
            "nudge": {
              "force": 2
            }
          },
          "body_name": "Dunmore",
          "body_lines": [
            "Dunmore. The ledger's open beside him. Every name in it paid."
          ]
        },
        "lost": {
          "leaves": false,
          "text": "Dunmore's back on his stool. His ledger has a new line in it: your name, and \"owes 2\".",
          "effects": {
            "set_flags": [
              "lost_to_dunmore"
            ]
          }
        }
      }
    }
  },
  "end_rules": [
    {
      "note": "Got in quietly through the hatch.",
      "if": [
        "sneaked_in"
      ],
      "effects": {
        "nudge": {
